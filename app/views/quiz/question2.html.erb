
<div class="quiz-page">

  <div class="quiz-card">

    <div class="quiz-step">
      Step 4 of 9
    </div>

    <div class="quiz-progress">
      <div
        class="quiz-progress-bar"
        style="width: 44%;">
      </div>
    </div>

    <h1 class="quiz-title">
      Are your teeth crowded at all?
    </h1>

    <p class="quiz-description">
      Please look at the examples below and select
      the option that most closely resembles your teeth.
    </p>

    <%= form_with url: "/quiz/2",
                  method: :post,
                  local: true do %>

      <div class="row g-3">

        <!-- MILD -->

        <div class="col-md-4">

          <div class="quiz-image-option">

            <%= radio_button_tag :crowding,
                "mild",
                session[:quiz]["crowding"] == "mild",
                required: true,
                id: "crowding_mild" %>

            <%= label_tag "crowding_mild" do %>

              <%= image_tag "quiz/crowded_mild.jpg",
                  class: "quiz-question-image" %>

              <div class="quiz-image-label">
                Mildly Crowded
              </div>

            <% end %>

          </div>

        </div>


        <!-- MODERATE -->

        <div class="col-md-4">

          <div class="quiz-image-option">

            <%= radio_button_tag :crowding,
                "moderate",
                session[:quiz]["crowding"] == "moderate",
                id: "crowding_moderate" %>

            <%= label_tag "crowding_moderate" do %>

              <%= image_tag "quiz/crowded_moderate.jpg",
                  class: "quiz-question-image" %>

              <div class="quiz-image-label">
                Moderately Crowded
              </div>

            <% end %>

          </div>

        </div>


        <!-- SEVERE -->

        <div class="col-md-4">

          <div class="quiz-image-option">

            <%= radio_button_tag :crowding,
                "severe",
                session[:quiz]["crowding"] == "severe",
                id: "crowding_severe" %>

            <%= label_tag "crowding_severe" do %>

              <%= image_tag "quiz/crowded_severe.jpg",
                  class: "quiz-question-image" %>

              <div class="quiz-image-label">
                Severely Crowded
              </div>

            <% end %>

          </div>

        </div>

      </div>


      <!-- NOT CROWDED -->

      <div class="not-crowded-option mt-4">

        <%= radio_button_tag :crowding,
            "none",
            session[:quiz]["crowding"] == "none",
            id: "crowding_none" %>

        <%= label_tag "crowding_none" do %>

          <span>
            Not Crowded
          </span>

        <% end %>

      </div>


      <!-- NAVIGATION -->

      <div class="quiz-navigation">

        <a href="/quiz/1" class="quiz-previous">
          ← Previous
        </a>

        <button type="submit" class="btn btn-primary quiz-next">
          Next →
        </button>

      </div>

    <% end %>

  </div>

</div>

<style>

.quiz-image-option {
  position: relative;
  height: 100%;
}

.quiz-image-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.quiz-image-option label {
  display: block;
  height: 100%;
  padding: 8px;
  border: 2px solid #e9ecef;
  border-radius: 14px;
  background: #fff;
  cursor: pointer;
  transition: all 0.2s ease;
}

.quiz-image-option label:hover {
  border-color: #0d6efd;
  transform: translateY(-2px);
}

.quiz-image-option input:checked + label {
  border-color: #0d6efd;
  background: #eef5ff;
  box-shadow: 0 4px 15px rgba(13, 110, 253, 0.15);
}

.quiz-question-image {
  display: block;
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 10px;
}

.quiz-image-label {
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  padding: 12px 5px 7px;
}

.not-crowded-option {
  position: relative;
}

.not-crowded-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.not-crowded-option label {
  display: block;
  padding: 15px 20px;
  border: 2px solid #e9ecef;
  border-radius: 12px;
  background: #fff;
  cursor: pointer;
  text-align: center;
  font-weight: 600;
  transition: all 0.2s ease;
}

.not-crowded-option label:hover {
  border-color: #0d6efd;
  background: #f8fbff;
}

.not-crowded-option input:checked + label {
  border-color: #0d6efd;
  background: #eef5ff;
  color: #0d6efd;
}

@media (max-width: 767px) {
  .quiz-question-image {
    height: 140px;
  }
}
</style>
