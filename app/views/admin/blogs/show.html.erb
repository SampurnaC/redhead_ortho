<div class="container mt-5">


  <div class="d-flex justify-content-between">

    <h1>
      <%= @blog.title %>
    </h1>


    <%= link_to "Back",
        admin_blogs_path,
        class: "btn btn-secondary" %>

  </div>



  <% if @blog.image.present? %>

    <%= image_tag @blog.image,
        class: "img-fluid my-4" %>

  <% end %>



  <div class="card">

    <div class="card-body">

      <%= simple_format(@blog.content) %>

    </div>

  </div>



</div>
