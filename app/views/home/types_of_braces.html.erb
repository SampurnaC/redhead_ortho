<section class="braces-section py-5">

  <div class="container">

    <h2>Our Range of Braces</h2>

    <p>
      At Redhead Orthodontics we offer a comprehensive range of braces for adults and children.
      So, no matter what your concern, we aim to correct every possible issue from teeth alignment and underbites to overcrowding – and everything in between.
    </p>

    <p>
      We use the very highest standards and modern orthodontic treatments for our patients. If you know the type of brace you want, please select it below to be shown further information, otherwise please scroll down to find further information on each type of brace we provide.
    </p>

    <div class="row g-4 mt-4">

      <!-- Clear Braces -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/clear-braces.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 clear-braces text-white">Clear Braces</p>
      </div>

      <!-- Lingual Brace -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/hiddenlingual.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 lingual-brace text-white">Lingual Brace</p>
      </div>

      <!-- Invisalign -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/Invisalign.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 invisalign-aligners text-white">Invisalign Aligners</p>
      </div>

      <!-- Tip Edge -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/Tip-edge-brace.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 tip-edge-brace text-white">Tip Edge Brace</p>
      </div>

      <!-- Pendulum -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/Pendulum-Appliance.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 text-white pendulum">Pendulum Appliance</p>
      </div>

      <!-- Fixed Twin Block -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/Fixed-Twin-Block.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 fixed-twin-block text-white">Fixed Twin Block</p>
      </div>

      <!-- Removable Twin Block -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/Removable-Twin-Bock.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 removable-twin-block text-white">Removable Twin Block</p>
      </div>

      <!-- Damon Brace -->
      <div class="col-6 col-md-4 col-lg-3 text-center">
        <%= image_tag "types_of_braces/Damon-Brace.jpg", class: "hero-bg-image img-fluid" %>
        <p class="mt-2 damon-brace text-white">Damon Brace</p>
      </div>

    </div>

 
    

  </div>

</section>


