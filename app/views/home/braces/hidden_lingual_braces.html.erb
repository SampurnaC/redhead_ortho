  color: white;
  text-decoration: none;
  background: rgba(0,0,0,0.5);
  width: 70px;
  height: 70px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.treatment-hero-fullwidth {
  width: 100%;
  margin: 40px 0;
  overflow: hidden;
}

.treatment-hero-img {
  width: 100%;
  max-width: 100%;
  height: 450px;
  object-fit: cover;
  display: block;
}
</style>
