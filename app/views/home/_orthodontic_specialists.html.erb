<section class="specialists-section py-5">
  <div class="container">

    <div class="row align-items-center g-5">

      <!-- IMAGE -->
      <div class="col-lg-6">
        <%= image_tag "orthodontic_specialist.jpg",
            class: "img-fluid specialist-image",
            alt: "Orthodontic Specialist" %>
      </div>

      <!-- CONTENT -->
      <div class="col-lg-6">

        <span class="section-label">
          ORTHODONTIC CARE
        </span>

        <h2 class="specialist-title mt-3">
          Orthodontic Specialists
        </h2>

        <p class="specialist-text">
          Qualifying from Kings College, London in 1990, with a Masters in
          Orthodontics in 1998, Alex Redhead has a special interest in
          Invisalign and Lingual braces and is one of the leading providers
          of this type of brace in London.
        </p>

        <div class="d-flex flex-wrap gap-3 mt-4">
        
      
        <%= link_to "View Our Range of Braces", types_of_braces_path, class: "btn btn-info btn-lg rounded-pill px-4 py-3" %>


        <a href="#" class="btn btn-success btn-lg rounded-pill px-4 py-3">
          Take The Best Brace Quiz
        </a>
      </div>

      </div>

    </div>

  </div>
</section>

<style>
.specialists-section {
  background: #ffffff;
  padding: 100px 0;
}

.specialist-image {
  border-radius: 20px;
  box-shadow: 0 12px 35px rgba(0,0,0,0.08);
}

.specialist-title {
  font-family: 'Playfair Display', serif;
  font-size: 2.8rem;
  font-weight: 600;
  color: #222;
}

.specialist-text {
  font-size: 1.1rem;
  line-height: 1.9;
  color: #666;
  margin-top: 20px;
}

.section-label {
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #888;
}
</style>
