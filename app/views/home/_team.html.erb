<section class="team-section py-5 bg-light">
  <div class="container text-center">

    <h2 class="fw-bold">Meet the Team</h2>

    <p class="text-muted mb-5">
      Our specialists are committed to providing patients with the very best care and experience.
    </p>



    <div class="row g-4">

      <!-- Member 1 -->
      <div class="col-md-4">
        <div class="team-card position-relative overflow-hidden rounded shadow-sm">
          <%= image_tag "Alex_Redhead_BW.jpg", class: "hero-bg-img w-100" %>

          <div class="team-overlay d-flex flex-column justify-content-center align-items-center text-white">

            <h5 class="fw-bold mb-1 text-white">Dr Alex Redhead</h5>

            <p class="mb-1 text-white">specialist Orthodontist</p>

            <div class="mt-2 small text-white">
              GDC: 66220<br>
              BDS (Lond)<br>
              FDS RCS (Eng)<br>
              MOrth RCS (Edin)
            </div>

          </div>
        </div>
      </div>

      <!-- Member 2 -->
      <div class="col-md-4">
        <div class="team-card position-relative overflow-hidden rounded shadow-sm">
          <%= image_tag "Shrestha_Manisha_BW.jpg", class: "hero-bg-img w-100" %>

          <div class="team-overlay d-flex flex-column justify-content-center align-items-center text-white">

            <h5 class="fw-bold mb-1 text-white">Manisha Shrestha</h5>

            <p class="mb-1 text-white">General Manager</p>

            <div class="mt-2 small text-white">
              GDC: 232278<br>
              BA (Hons)<br>
            </div>

          </div>
        </div>
      </div>
      
      <!-- Member 3 -->
      <div class="col-md-4">
        <div class="team-card position-relative overflow-hidden rounded shadow-sm">
          <%= image_tag "jade-kilford-BW.jpg", class: "hero-bg-img w-100" %>

          <div class="team-overlay d-flex flex-column justify-content-center align-items-center text-white">

            <h5 class="fw-bold mb-1 text-white">Jade Kilford</h5>

            <p class="mb-1 text-white">Orthodontic Nurse</p>

            <div class="mt-2 small text-white">
              GDC: 159629<br>
              National Certificate in Dental Nursing<br>
            </div>

          </div>
        </div>
      </div>

    </div>


    
  </div>
</section>

<style>
.team-card {
  cursor: pointer;
}

.team-card img {
  height: 350px;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.team-card:hover img {
  transform: scale(1.05);
}

.team-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.65);
  opacity: 0;
  transition: all 0.3s ease;
  text-align: center;
  padding: 20px;
}

.team-card:hover .team-overlay {
  opacity: 1;
}
</style>
