<section class="hero-section d-flex align-items-center">
  
  <div class="hero-bg">
    <%= image_tag "redhead_hero_image.jpg", class: "hero-bg-img" %>
  </div>

  <div class="container-fluid position-relative px-5">
    <div class="row justify-content-start">
      <div class="col-lg-6 col-md-12 hero-content">
        
      <h1 class="hero-title text-white fw-bold">
  
        <span class="display-2 d-block">
          Leading Orthodontics
        </span>
      
        <span class="d-block mt-2 hero-subtitle-line">
          <span class="big-letter">I</span>N THE H<span class="big-letter">E</span>ART OF LONDON
        </span>
      
      </h1>

      <div class="hero-buttons mt-5">

      <div class="row g-3">
    
        <div class="col-12 col-lg-6">
          <%= link_to "BRACES",
              types_of_braces_path,
              class: "btn btn-braces btn-lg w-100" %>
        </div>
    
        <div class="col-12 col-lg-6">
          <%= link_to "TREATMENTS",
              treatments_path,
              class: "btn btn-treatments btn-lg w-100" %>
        </div>
    
        <div class="col-12 col-md-6">
          <%= link_to "REQUEST A CONSULTATION",
              new_appointment_path,
              class: "btn btn-consultation btn-lg w-100" %>
        </div>
    
        <div class="col-12 col-md-6">
          <%= link_to "BOOK ONLINE",
              "https://redhead-orthodontics.portal.dental/",
              class: "btn btn-warning btn-lg w-100",
              target: "_blank",
              rel: "noopener" %>
        </div>
    
      </div>
    
    </div>
      

      </div>
    </div>
  </div>

</section>

<section class="py-5 bg-light border-bottom">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9 text-center">
        <p class="fs-5 text-muted mb-0">
          One of the leading London Orthodontic Practices, Dr Redhead and his team take enormous care to ensure your orthodontic treatment is of the very highest standard.
          
        </p>
      </div>
    </div>
  </div>
</section>

<%= render "google_review" %>

<%= render "orthodontic_specialists" %>

<%= render "types_of_braces" %>

<%= render "where_to_start" %>

<%= render "team" %>

<%= render "our_promise_to_you" %>

<%= render "proud_members" %>

<%= render "footer" %>



<style>


.hero-title {
  line-height: 1.1;
}

.hero-subtitle-line {
  font-size: 1.6rem;
  letter-spacing: 3px;
}

.big-letter {
  font-size: 2.2rem;
  font-weight: 800;
  color: #fff;
}


.hero-section {
  min-height: 90vh;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-section::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 850px;
}

@media (min-width: 992px) {
  .hero-content {
    margin-left: -30px;
    transform: translateY(-25px);
  }
}

.hero-title {
  font-weight: 1000;
  line-height: 1.05;
  margin-bottom: 0;
}

.hero-subtitle {
  font-size: 18px;
  color: #444;
}



.btn-braces {
  background: #2f6fed;
  color: #fff;
}

.btn-braces:hover {
  background: #1f56c7;
  transform: translateY(-2px);
}

.btn-treatments {
  background: #6f42c1;
  color: #fff;
}

.btn-treatments:hover {
  background: #5a32a3;
  transform: translateY(-2px);
}

.btn-appointments {
  background: #20c997;
  color: #fff;
}

.btn-appointments:hover {
  background: #179c79;
  transform: translateY(-2px);
}




.hero-buttons .btn {
  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 70px;

  padding: 18px 30px;

  font-weight: 700;

  letter-spacing: .8px;

  border-radius: 12px;

  transition: all .3s ease;
}


.hero-buttons .btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 30px rgba(0,0,0,.18);
}




/* Braces */
.btn-braces {
  background: #0F4C81;
  color: #fff;
  border: none;
}

.btn-braces:hover {
  background: #0C3D66;
  color: #fff;
}

/* Treatments */
.btn-treatments {
  background: #20A39E;
  color: #fff;
  border: none;
}

.btn-treatments:hover {
  background: #19857F;
  color: #fff;
}

/* Consultation */
.btn-consultation {
  background: #F4A261;
  color: #fff;
  border: none;
}

.btn-consultation:hover {
  background: #E58E45;
  color: #fff;
}

/* Dentally */
.btn-warning {
  color: #fff;
}

.btn-warning:hover {
  color: #fff;
}
</style>
