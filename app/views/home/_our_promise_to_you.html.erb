<section class="hero-section d-flex align-items-center text-center text-white">


  <%= image_tag "our_promise_to_you.jpg", class: "hero-bg-image" %>

  <div class="container position-relative">

    <h2 class="lead mb-3 leadtext text-white">
      Our Promise To You
    </h2>

    <p class="lead mb-3 text-white fst-italic fs-3 lh-base">
      Customer Care is crucially important to the practice. Unlike some alternatives where you may be treated by an auxiliary nurse, Dr Redhead personally treats every patient. There are five main principles that underpin our work which patients can expect from us...
    </p>

  
    <%= link_to "FIND OUT MORE", promise_path, class: "btn btn-danger btn-lg px-5 py-3 fw-bold rounded-pill" %>
  </div>

</section>

<style>

/* SAME HERO STYLE USED FOR BOTH SECTIONS */
.hero-section {
  position: relative;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* background image */
.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* overlay */
.hero-section .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1;
}

/* content */
.hero-section .container {
  z-index: 2;
  max-width: 900px;
}

/* button (shared style) */
.hero-section .btn {
  transition: all 0.3s ease;
}

.hero-section .btn:hover {
  transform: translateY(-3px);
}
</style>
