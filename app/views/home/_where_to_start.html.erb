<section class="hero-section d-flex align-items-center text-center text-white">

  <%= image_tag "where_to_start.jpg", class: "hero-bg-image" %>

  <div class="overlay"></div>

  <div class="container position-relative">

    <h1 class="lead mb-3 leadtext">
      Do you not quite know where to start?
    </h1>

    <p class="lead mb-3 text-white fst-italic fs-3 lh-base">
      Are you slightly confused with the range of braces on offer? Take the first steps to a better smile. Our fun Best Brace Quiz only takes a minute and you will receive an instant recommendation on which brace could be best for you!
    </p>

    <a href="#" class="btn btn-quiz">
      TAKE THE BEST BRACE QUIZ NOW
    </a>

  </div>

</section>
<style>
.hero-section {
  position: relative;
  min-height: 70vh;
  overflow: hidden;
}

.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-section .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1;
}

.hero-section .container {
  position: relative;
  z-index: 2;
}

.btn-quiz {
  background: #ffc107;
  color: #000;
  font-weight: 700;
  padding: 14px 40px;
  border-radius: 50px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  transition: all 0.3s ease;
  text-transform: uppercase;
}

.btn-quiz:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 25px rgba(0,0,0,0.25);
  background: #ffb300;
  color: #000;
}
</style>
